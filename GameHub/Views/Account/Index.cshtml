@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "Account";
}

<section class="min-h-[calc(100vh-64px)] px-8 py-12">
    <div class="max-w-5xl mx-auto">

        <div class="flex items-center justify-between">
            <h1 class="text-gray-900 text-2xl font-medium">My Account</h1>
            <div class="flex items-center gap-4">
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="text-gray-500 text-sm hover:text-gray-900 transition-colors">Logout</button>
                </form>
                <a asp-controller="Account" asp-action="Orders" class="h-11 px-4 rounded-full text-white bg-black hover:opacity-90 transition-opacity text-sm font-medium flex items-center">
                    View Purchase History
                </a>
            </div>
        </div>

        <div class="flex items-center pt-10 pb-6">
            <div class="min-w-0">
                <p class="text-gray-900 font-medium truncate">@Model.UserName</p>
                <p class="text-gray-500 text-sm truncate">@Model.Email</p>
            </div>
        </div>

    </div>
</section>