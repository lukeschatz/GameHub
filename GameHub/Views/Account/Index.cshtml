@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "Account";
}

<section class="flex min-h-[calc(100vh-64px)] items-center justify-center">
    <div class="max-w-96 w-full border border-gray-300/60 rounded-2xl px-8 bg-white">

        <div class="flex items-center pt-10 pb-6">
            <div class="min-w-0">
                <p class="text-gray-900 font-medium truncate">@Model.UserName</p>
                <p class="text-gray-500 text-sm truncate">@Model.Email</p>
            </div>
        </div>
            
        <div class="mt-6 flex items-center w-full bg-white border border-gray-300/80 h-12 rounded-full overflow-hidden pl-6 gap-2">
            <svg width="13" height="17" viewBox="0 0 13 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M13 8.5c0-.938-.729-1.7-1.625-1.7h-.812V4.25C10.563 1.907 8.74 0 6.5 0S2.438 1.907 2.438 4.25V6.8h-.813C.729 6.8 0 7.562 0 8.5v6.8c0 .938.729 1.7 1.625 1.7h9.75c.896 0 1.625-.762 1.625-1.7zM4.063 4.25c0-1.406 1.093-2.55 2.437-2.55s2.438 1.144 2.438 2.55V6.8H4.061z" fill="#6B7280" />
            </svg>
            <span class="text-gray-500 text-sm truncate">@Model.UserName</span>
        </div>

        <div class="mt-4 flex items-center w-full bg-white border border-gray-300/80 h-12 rounded-full overflow-hidden pl-6 gap-2">
            <svg width="16" height="11" viewBox="0 0 16 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M0 .55.571 0H15.43l.57.55v9.9l-.571.55H.57L0 10.45zm1.143 1.138V9.9h13.714V1.69l-6.503 4.8h-.697zM13.749 1.1H2.25L8 5.356z" fill="#6B7280" />
            </svg>
            <span class="text-gray-500 text-sm truncate">@Model.Email</span>
        </div>

        <div class="mt-8 pt-6 pb-10 flex items-center justify-between">
            <a asp-controller="Account" asp-action="Orders" class="h-11 px-4 rounded-full text-white bg-black hover:opacity-90 transition-opacity text-sm font-medium flex items-center">View purchased accounts</a>

            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="text-gray-500 text-sm hover:text-gray-900 transition-colors">Logout</button>
            </form>
        </div>

    </div>
</section>