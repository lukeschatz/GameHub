@model IEnumerable<GameHub.Models.Order>


@{
    ViewData["Title"] = "Account orders";
}

<section class="min-h-[calc(100vh-64px)] px-8 py-12">
    <div class="max-w-5xl mx-auto">

        <div class="flex items-center justify-between">
            <h1 class="text-gray-900 text-2xl font-medium">My Purchase History</h1>
            <div class="flex items-center gap-4">
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="text-gray-500 text-sm hover:text-gray-900 transition-colors">Logout</button>
                </form>
                <a asp-controller="Account" asp-action="Index" class="h-11 px-4 rounded-full text-white bg-black hover:opacity-90 transition-opacity text-sm font-medium flex items-center">
                    View Account
                </a>
            </div>
        </div>

        <div >
            @if (!Model.Any()) {
                <p class="text-gray-500 text-sm pb-10">You havent brought any accounts.</p>
            }
            else {
                <div class="pb-10 mt-10 space-y-3">
                    @foreach (var item in Model) {
                        <div class="flex items-center justify-between w-full bg-white border border-gray-300/80 rounded-2xl px-6 py-4 gap-4">
                            <div class="min-w-0">
                                <p class="text-gray-900 font-medium truncate">@item.Title</p>
                                <p class="text-gray-500 text-sm truncate">Seller: @(item.User?.UserName ?? "Unknown")</p>
                                <p class="text-gray-500 text-sm truncate">@item.AccountInfoPrivate</p>
                            </div>
                            <a asp-controller="Purchase" asp-action="Index" asp-route-id="@item.Id"
                               class="h-11 px-4 rounded-full text-white bg-black hover:opacity-90 transition-opacity text-sm font-medium flex items-center shrink-0">
                                View Account Information
                            </a>
                        </div>
                    }
                </div>
            }

        </div>


    </div>
</section>