@model GameHub.Models.Order
@{
    ViewData["Title"] = "Delete listing";
}

<section class="flex min-h-[calc(100vh-64px)] items-center justify-center">
    <div class="max-w-96 w-full px-8 py-10 bg-white">

        <h1 class="text-gray-900 text-2xl font-medium">Delete Listing</h1>
        <p class="text-red-500 text-sm mt-2">Are you sure you want to delete this listing? This action cannot be undone.</p>

        <div class="mt-6 bg-white border border-gray-300/80 rounded-2xl px-6 py-4">
            <p class="text-gray-900 font-medium truncate">@Model.Title</p>
            <p class="text-gray-500 text-sm mt-1">@Model.Body</p>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="mt-8 w-full h-11 rounded-full text-white bg-red-500 hover:opacity-90 transition-opacity text-sm font-medium">
                Confirm Delete
            </button>
        </form>

        <a asp-action="Index" class="mt-3 block text-center w-full h-11 leading-[44px] rounded-full text-gray-700 border border-gray-300/80 hover:bg-gray-50 transition-colors text-sm font-medium">
            Cancel
        </a>

    </div>
</section>