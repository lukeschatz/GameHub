@{
    ViewData["Title"] = "Listings";
}

@model IEnumerable<GameHub.Models.Order>

<h2>My Listings</h2>
<a asp-action="Create">Create New Listing</a>

<table>
    <thead>
        <tr>
            <th>Title</th>
            <th>Status</th>
            <th>Created</th>
            <th>Private Info</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@(item.Sold ? "Sold" : "Active")</td>
                <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>@item.AccountInfoPrivate</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>