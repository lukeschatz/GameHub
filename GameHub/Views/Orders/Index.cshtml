@{
    ViewData["Title"] = "Listings";
}

@model IEnumerable<GameHub.Models.Order>

<section class="min-h-[calc(100vh-64px)] px-8 py-12">
    <div class="max-w-5xl mx-auto">

        <div class="flex items-center justify-between">
            <h1 class="text-gray-900 text-2xl font-medium">My Listings</h1>
            <a asp-action="Create" class="h-11 px-4 rounded-full text-white bg-orange-400 hover:opacity-90 transition-opacity text-sm font-medium flex items-center">
                Create New Listing
            </a>
        </div>

        @if (!Model.Any()) {
            <p class="text-gray-500 text-sm mt-10">You haven't created any listings yet.</p>
        }
        else {
            <div class="mt-8 space-y-3">
                @foreach (var item in Model) {
                    <div class="flex items-center justify-between w-full bg-orange-400 border border-gray-300/80 rounded-2xl px-6 py-4 gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-gray-900 font-medium truncate">@item.Title</p>
                            </div>
                            @if (item.Sold) {
                                <p class="text-xs font-medium text-black">Sold</p>
                            }
                            else {
                                <p class="text-xs font-medium text-green-700">Active</p>
                            }
                            <p class="text-black text-xs mt-1.5">Created @item.CreatedAt.ToLocalTime().ToString("g")</p>
                            <p class="text-black text-sm mt-1 truncate">@item.AccountInfoPrivate</p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="h-9 px-4 rounded-full border border-gray-300/80 text-gray-700 hover:bg-gray-50 transition-colors text-sm font-medium flex items-center">
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="h-9 px-4 rounded-full border border-gray-300/80 text-red-500 hover:bg-red-50 transition-colors text-sm font-medium flex items-center">
                                Delete
                            </a>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>