@{
    ViewData["Title"] = "Gamehub";
}

@model (List<GameHub.Models.Order> Latest, List<GameHub.Models.Order> Oldest)


   <section class="container-fluid my-bg rounded-2xl text-white text-center py-5">
    <div class="container"> <h1 class="display-4 fw-bold">Welcome to GameHub</h1> 
        <p class="lead"> Open your mind and discover a new world. 

        </p> 
        
    </div> 
        
    
    
   </section>
<style>
    .my-bg {
        background-image: url('/Banner.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 350px;
        width: 100%;
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }
</style>


<section class="min-h-[calc(100vh-64px)] px-8 py-12">
    <div class="max-w-5xl mx-auto">

        <h1 class="text-gray-900 text-2xl font-medium">Latest Listed</h1>
        @if (!Model.Latest.Any()) {
            <p class="text-gray-500 text-sm mt-10">No listings available.</p>
        }
        else {
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                @foreach (var item in Model.Latest) {
                    <div class="flex flex-col justify-between bg-white border border-gray-300/80 rounded-2xl px-4 py-4">
                        <div class="min-w-0">
                            <p class="text-gray-900 font-medium truncate">@item.Title</p>
                            <p class="text-gray-500 text-sm mt-1.5">@(item.Body.Length > 120 ? item.Body.Substring(0, 120) + "..." : item.Body)</p>
                            <p class="text-gray-400 text-xs mt-2">Seller: @(item.User?.UserName ?? "Unknown")</p>
                        </div>
                        <a asp-controller="Purchase" asp-action="Index" asp-route-id="@item.Id" class="mt-4 h-11 rounded-full text-white bg-black hover:opacity-90 transition-opacity text-sm font-medium flex items-center justify-center">View Listing</a>
                    </div>
                }
            </div>
        }

        <h1 class="mt-16 text-gray-900 text-2xl font-medium">Oldest Listed</h1>
        @if (!Model.Oldest.Any()) {
            <p class="text-gray-500 text-sm mt-10">No listings available.</p>
        }
        else {
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                @foreach (var item in Model.Oldest) {
                    <div class="flex flex-col justify-between bg-white border border-gray-300/80 rounded-2xl px-4 py-4">
                        <div class="min-w-0">
                            <p class="text-gray-900 font-medium truncate">@item.Title</p>
                            <p class="text-gray-500 text-sm mt-1.5">@(item.Body.Length > 120 ? item.Body.Substring(0, 120) + "..." : item.Body)</p>
                            <p class="text-gray-400 text-xs mt-2">Seller: @(item.User?.UserName ?? "Unknown")</p>
                        </div>
                        <a asp-controller="Purchase" asp-action="Index" asp-route-id="@item.Id" class="mt-4 h-11 rounded-full text-white bg-black hover:opacity-90 transition-opacity text-sm font-medium flex items-center justify-center">View Listing</a>
                    </div>
                }
            </div>
        }

    </div>
</section>