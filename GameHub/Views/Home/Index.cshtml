@{
    ViewData["Title"] = "Gamehub";
}

@model (List<GameHub.Models.Order> Latest, List<GameHub.Models.Order> Oldest)

@{
    ViewData["Title"] = "Gamehub";
}
   <!-- Hero Section --> 
   <section class="container-fluid bg-dark text-white text-center py-5">
    <div class="container"> <h1 class="display-4 fw-bold">Welcome to GameHub</h1> 
        <p class="lead"> Open your mind and discover a new world. 

        </p> 
        
    </div> 
        
    
    </section>
<h3>Latest Listed</h3>
<a asp-controller="Search" asp-action="Index">View All</a>

@if (!Model.Latest.Any())
{
    <p>No listings available.</p>
}
else
{
    @foreach (var item in Model.Latest)
    {
        <div>
            <h5>@item.Title</h5>
            <p>@(item.Body.Length > 80 ? item.Body.Substring(0, 80) + "..." : item.Body)</p>
            <p>@item.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</p>
            <a asp-controller="Purchase" asp-action="Index" asp-route-id="@item.Id">View</a>
        </div>
    }
}

<h3>Oldest Listed</h3>
<a asp-controller="Search" asp-action="Index">View All</a>

@if (!Model.Oldest.Any())
{
    <p>No listings available.</p>
}
else
{
    @foreach (var item in Model.Oldest)
    {
        <div>
            <h5>@item.Title</h5>
            <p>@(item.Body.Length > 80 ? item.Body.Substring(0, 80) + "..." : item.Body)</p>
            <p>@item.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</p>
            <a asp-controller="Purchase" asp-action="Index" asp-route-id="@item.Id">View</a>
        </div>
    }
}